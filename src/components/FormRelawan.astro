---
// FormRelawan.astro – Ultra-minimal registration form
import { masterRelawanList } from "../data/relawanList";
---

<div class="w-full max-w-lg mx-auto">
  <!-- Status Alert Banner -->
  <div
    id="formAlert"
    class="hidden mb-5 p-3.5 rounded-xl text-sm font-medium border"
  >
  </div>

  <form
    id="relawanForm"
    class="bg-white rounded-2xl border border-slate-200/80 shadow-xs divide-y divide-slate-100"
  >
    <!-- Form Body -->
    <div class="p-6 space-y-5">
      <!-- Hidden jenisKelamin -->
      <input type="hidden" id="jenisKelamin" name="jenisKelamin" value="" />

      <!-- Nama Lengkap – searchable combobox -->
      <div class="space-y-1.5 relative" id="searchableNameContainer">
        <label
          for="namaLengkap"
          class="block text-xs font-semibold text-slate-500 uppercase tracking-wider"
        >
          Nama Lengkap <span class="text-rose-500">*</span>
        </label>
        <div class="relative">
          <input
            type="text"
            id="namaLengkap"
            name="namaLengkap"
            required
            autocomplete="off"
            placeholder="Cari nama relawan..."
            class="shadcn-input pr-9"
          />
          <button
            type="button"
            id="toggleDropdownBtn"
            tabindex="-1"
            class="absolute right-2.5 top-2.5 text-slate-400 hover:text-slate-700"
          >
            <svg
              id="dropdownArrow"
              class="w-4 h-4 transition-transform duration-150"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
        </div>
        <!-- Dropdown -->
        <div
          id="nameDropdown"
          class="absolute left-0 right-0 top-full mt-1 bg-white border border-slate-200 rounded-xl shadow-lg max-h-52 overflow-y-auto z-50 hidden divide-y divide-slate-50"
        >
        </div>
      </div>

      <!-- NIK -->
      <div class="space-y-1.5">
        <div class="flex justify-between items-center">
          <label
            for="nik"
            class="block text-xs font-semibold text-slate-500 uppercase tracking-wider"
          >
            NIK <span class="text-rose-500">*</span>
          </label>
          <span id="nikCounter" class="text-xs text-slate-400 font-mono"
            >0/16</span
          >
        </div>
        <div class="relative">
          <input
            type="text"
            id="nik"
            name="nik"
            maxlength="16"
            required
            placeholder="16 digit NIK sesuai KTP"
            class="shadcn-input font-mono tracking-wider pr-9"
          />
          <div id="nikStatusIcon" class="absolute right-3 top-2.5 hidden">
            <svg
              class="w-5 h-5 text-emerald-600"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M5 13l4 4L19 7"></path>
            </svg>
          </div>
        </div>
      </div>

      <!-- Email & Nomor HP -->
      <div class="space-y-5">
        <div class="space-y-1.5">
          <label
            for="email"
            class="block text-xs font-semibold text-slate-500 uppercase tracking-wider"
          >
            Email <span class="text-rose-500">*</span>
          </label>
          <input
            type="email"
            id="email"
            name="email"
            required
            placeholder="email@gmail.com"
            class="shadcn-input"
          />
        </div>
        <div class="space-y-1.5">
          <label
            for="nomorHp"
            class="block text-xs font-semibold text-slate-500 uppercase tracking-wider"
          >
            Nomor HP <span class="text-rose-500">*</span>
          </label>
          <input
            type="tel"
            id="nomorHp"
            name="nomorHp"
            required
            placeholder="08xxxxxxxxxx"
            class="shadcn-input font-mono"
          />
        </div>
      </div>

      <!-- Divisi -->
      <div class="space-y-1.5">
        <label
          for="jabatan"
          class="block text-xs font-semibold text-slate-500 uppercase tracking-wider"
        >
          Divisi <span class="text-rose-500">*</span>
        </label>
        <select
          id="jabatan"
          name="jabatan"
          required
          class="shadcn-input bg-white cursor-pointer"
        >
          <option value="" disabled selected>Pilih divisi</option>
          <option value="Persiapan">Persiapan</option>
          <option value="Pengolahan">Pengolahan</option>
          <option value="Pemorsian">Pemorsian</option>
          <option value="Distribusi">Distribusi</option>
          <option value="Kebersihan">Kebersihan</option>
          <option value="Cuci Ompreng">Cuci Ompreng</option>
        </select>
      </div>
    </div>

    <!-- Footer actions -->
    <div
      class="px-6 py-4 flex items-center justify-between bg-slate-50/50 rounded-b-2xl"
    >
      <button
        type="button"
        id="resetBtn"
        class="text-xs text-slate-400 hover:text-slate-700 font-medium cursor-pointer"
      >
        Reset
      </button>
      <button
        type="submit"
        id="submitBtn"
        class="shadcn-button flex items-center gap-2 text-xs h-9 px-5"
      >
        <span id="btnText">Kirim</span>
        <svg
          id="btnSpinner"
          class="w-3.5 h-3.5 text-white animate-spin hidden"
          fill="none"
          viewBox="0 0 24 24"
        >
          <circle
            class="opacity-25"
            cx="12"
            cy="12"
            r="10"
            stroke="currentColor"
            stroke-width="4"></circle>
          <path
            class="opacity-75"
            fill="currentColor"
            d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
          ></path>
        </svg>
      </button>
    </div>
  </form>
</div>

<!-- Inject master dataset for client-side use -->
<script is:inline define:vars={{ masterRelawanList }}>
  window.MASTER_RELAWAN_LIST = masterRelawanList;
</script>

<script>
  // ── SEARCHABLE SELECT ──────────────────────────────────────
  const nameInput = document.getElementById("namaLengkap") as HTMLInputElement;
  const nameDropdown = document.getElementById(
    "nameDropdown",
  ) as HTMLDivElement;
  const toggleBtn = document.getElementById("toggleDropdownBtn");
  const arrow = document.getElementById("dropdownArrow");
  const jkHidden = document.getElementById("jenisKelamin") as HTMLInputElement;
  const masterList = (window as any).MASTER_RELAWAN_LIST as {
    nama: string;
    jk: string;
  }[];

  const esc = (s: string) =>
    s
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");

  const renderItems = (q = "") => {
    const lower = q.toLowerCase().trim();
    const items = lower
      ? masterList.filter((i) => i.nama.toLowerCase().includes(lower))
      : masterList;

    if (!items.length) {
      nameDropdown.innerHTML = `<div class="px-3 py-2.5 text-xs text-slate-400 italic">Nama tidak ditemukan dalam daftar.</div>`;
    } else {
      nameDropdown.innerHTML = items
        .map(
          (i) => `
        <button type="button"
          class="dropdown-item w-full text-left px-3 py-2.5 text-sm flex items-center justify-between hover:bg-slate-50 transition-colors"
          data-nama="${esc(i.nama)}" data-jk="${i.jk}">
          <span class="font-medium text-slate-800">${esc(i.nama)}</span>
          <span class="text-xs px-2 py-0.5 rounded-full font-semibold ${i.jk === "L" ? "bg-blue-50 text-blue-700" : "bg-pink-50 text-pink-700"}">
            ${i.jk === "L" ? "L" : "P"}
          </span>
        </button>
      `,
        )
        .join("");

      nameDropdown
        .querySelectorAll<HTMLButtonElement>(".dropdown-item")
        .forEach((el) => {
          el.addEventListener("click", () => {
            nameInput.value = el.dataset.nama!;
            jkHidden.value = el.dataset.jk === "L" ? "Laki-laki" : "Perempuan";
            hideDropdown();
          });
        });
    }
  };

  const showDropdown = () => {
    renderItems(nameInput.value);
    nameDropdown.classList.remove("hidden");
    arrow?.classList.add("rotate-180");
  };

  const hideDropdown = () => {
    nameDropdown.classList.add("hidden");
    arrow?.classList.remove("rotate-180");
  };

  nameInput.addEventListener("focus", showDropdown);
  nameInput.addEventListener("input", () => {
    showDropdown();
    const matched = masterList.find(
      (i) => i.nama.toLowerCase() === nameInput.value.toLowerCase().trim(),
    );
    if (matched)
      jkHidden.value = matched.jk === "L" ? "Laki-laki" : "Perempuan";
  });

  toggleBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    nameDropdown.classList.contains("hidden") ? showDropdown() : hideDropdown();
  });

  document.addEventListener("click", (e) => {
    if (
      !document
        .getElementById("searchableNameContainer")
        ?.contains(e.target as Node)
    ) {
      hideDropdown();
    }
  });

  // ── NIK COUNTER ──────────────────────────────────────────
  const nikInput = document.getElementById("nik") as HTMLInputElement;
  const nikCounter = document.getElementById("nikCounter")!;
  const nikIcon = document.getElementById("nikStatusIcon")!;

  nikInput?.addEventListener("input", () => {
    let v = nikInput.value.replace(/\D/g, "").slice(0, 16);
    nikInput.value = v;
    nikCounter.textContent = `${v.length}/16`;
    if (v.length === 16) {
      nikCounter.className = "text-xs text-emerald-600 font-mono font-bold";
      nikIcon.classList.remove("hidden");
    } else {
      nikCounter.className = "text-xs text-slate-400 font-mono";
      nikIcon.classList.add("hidden");
    }
  });

  // ── FORM SUBMISSION ───────────────────────────────────────
  const form = document.getElementById("relawanForm") as HTMLFormElement;
  const formAlert = document.getElementById("formAlert")!;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    const submitBtn = document.getElementById("submitBtn") as HTMLButtonElement;
    const btnText = document.getElementById("btnText")!;
    const spinner = document.getElementById("btnSpinner")!;

    submitBtn.disabled = true;
    btnText.textContent = "Mengirim...";
    spinner.classList.remove("hidden");
    formAlert.classList.add("hidden");

    const fd = new FormData(form);
    const payload = {
      namaLengkap: fd.get("namaLengkap"),
      nik: fd.get("nik"),
      email: fd.get("email"),
      jabatan: fd.get("jabatan"),
      jenisKelamin: fd.get("jenisKelamin"),
      nomorHp: fd.get("nomorHp"),
    };

    try {
      const res = await fetch("/api/relawan", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      const json = await res.json();

      if (res.ok && json.success) {
        // Redirect to thank-you page
        const namaEncoded = encodeURIComponent(String(payload.namaLengkap));
        window.location.href = `/terima-kasih?nama=${namaEncoded}`;
      } else {
        formAlert.className =
          "mb-5 p-3.5 rounded-xl text-sm font-medium border bg-rose-50 text-rose-800 border-rose-200";
        formAlert.textContent =
          json.message || "Terjadi kesalahan saat memproses data.";
        formAlert.classList.remove("hidden");
      }
    } catch (err: any) {
      formAlert.className =
        "mb-5 p-3.5 rounded-xl text-sm font-medium border bg-rose-50 text-rose-800 border-rose-200";
      formAlert.textContent = "Kesalahan sistem: " + err.message;
      formAlert.classList.remove("hidden");
    } finally {
      submitBtn.disabled = false;
      btnText.textContent = "Kirim Pendataan";
      spinner.classList.add("hidden");
    }
  });

  // ── RESET ─────────────────────────────────────────────────
  document.getElementById("resetBtn")?.addEventListener("click", () => {
    form?.reset();
    nikCounter.textContent = "0/16";
    nikIcon.classList.add("hidden");
    formAlert.classList.add("hidden");
    jkHidden.value = "";
  });
</script>
