---
// DaftarRelawan.astro - Admin Relawan Table & Management
---

<div class="w-full max-w-6xl mx-auto space-y-6">
  <!-- Header Card & Actions -->
  <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-xs flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
    <div>
      <h2 class="text-xl font-bold text-slate-900 flex items-center gap-2">
        <svg class="w-5 h-5 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
        </svg>
        Data Relawan Terdaftar
      </h2>
      <p class="text-xs text-slate-500 mt-0.5">Kelola data relawan Dapur SPPG Pahlawan. Edit, hapus, dan ekspor data ke Excel / JSON.</p>
    </div>

    <div class="flex items-center gap-2.5 w-full md:w-auto justify-end flex-wrap">
      <!-- Total Count Badge -->
      <div class="bg-slate-100 border border-slate-200/80 px-3.5 py-1.5 rounded-xl text-center">
        <span class="text-[10px] uppercase font-bold text-slate-400 block">Total</span>
        <span id="totalRelawanCount" class="text-base font-extrabold text-slate-900 font-mono">0</span>
      </div>

      <!-- Export Excel -->
      <button
        id="exportExcelBtn"
        class="shadcn-button bg-emerald-700 hover:bg-emerald-800 text-white flex items-center gap-1.5 text-xs h-9 px-3"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
        </svg>
        Export Excel (.xlsx)
      </button>

      <!-- Export JSON -->
      <button
        id="exportJsonBtn"
        class="shadcn-button bg-indigo-700 hover:bg-indigo-800 text-white flex items-center gap-1.5 text-xs h-9 px-3"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
        </svg>
        Export JSON
      </button>
    </div>
  </div>

  <!-- Controls: Search & Divisi Filter -->
  <div class="bg-white rounded-2xl border border-slate-200 p-4 shadow-xs grid grid-cols-1 sm:grid-cols-2 gap-3">
    <div class="relative">
      <input
        type="text"
        id="searchRelawan"
        placeholder="Cari berdasarkan nama, NIK, atau email..."
        class="shadcn-input pl-9"
      />
      <svg class="w-4 h-4 text-slate-400 absolute left-3 top-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
    </div>

    <select id="filterJabatan" class="shadcn-input bg-white">
      <option value="">Semua Divisi Relawan</option>
      <option value="Persiapan">Persiapan</option>
      <option value="Pengolahan">Pengolahan</option>
      <option value="Pemorsian">Pemorsian</option>
      <option value="Distribusi">Distribusi</option>
      <option value="Kebersihan">Kebersihan</option>
      <option value="Cuci Ompreng">Cuci Ompreng</option>
    </select>
  </div>

  <!-- Data Table -->
  <div class="bg-white rounded-2xl border border-slate-200 shadow-xs overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="bg-slate-50 border-b border-slate-200 text-xs font-semibold text-slate-500 uppercase tracking-wider">
          <tr>
            <th class="px-4 py-3.5">Nama & NIK</th>
            <th class="px-4 py-3.5">Kontak</th>
            <th class="px-4 py-3.5">Divisi</th>
            <th class="px-4 py-3.5">Gender</th>
            <th class="px-4 py-3.5 text-right">Aksi</th>
          </tr>
        </thead>
        <tbody id="relawanTableBody" class="divide-y divide-slate-100">
          <tr>
            <td colspan="5" class="px-4 py-8 text-center text-slate-400">
              Memuat data relawan...
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Edit Modal Dialog -->
<div id="editModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-xs flex items-center justify-center p-4 z-50 hidden">
  <div class="bg-white rounded-2xl border border-slate-200 shadow-xl w-full max-w-lg overflow-hidden animate-in fade-in zoom-in-95 duration-150">
    <div class="p-5 border-b border-slate-100 flex items-center justify-between">
      <h3 class="font-bold text-slate-900 text-base">Edit Data Relawan</h3>
      <button id="closeEditModalBtn" class="text-slate-400 hover:text-slate-700">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <form id="editRelawanForm" class="p-5 space-y-4 max-h-[75vh] overflow-y-auto">
      <input type="hidden" id="editId" name="id" />

      <div class="space-y-1">
        <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500">Nama Lengkap</label>
        <input type="text" id="editNama" name="namaLengkap" required class="shadcn-input" />
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div class="space-y-1">
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500">NIK (16 Digit)</label>
          <input type="text" id="editNik" name="nik" maxlength="16" required class="shadcn-input font-mono" />
        </div>
        <div class="space-y-1">
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500">Divisi</label>
          <select id="editJabatan" name="jabatan" required class="shadcn-input">
            <option value="Persiapan">Persiapan</option>
            <option value="Pengolahan">Pengolahan</option>
            <option value="Pemorsian">Pemorsian</option>
            <option value="Distribusi">Distribusi</option>
            <option value="Kebersihan">Kebersihan</option>
            <option value="Cuci Ompreng">Cuci Ompreng</option>
          </select>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div class="space-y-1">
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500">Email</label>
          <input type="email" id="editEmail" name="email" required class="shadcn-input" />
        </div>
        <div class="space-y-1">
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500">Nomor HP</label>
          <input type="tel" id="editHp" name="nomorHp" required class="shadcn-input font-mono" />
        </div>
      </div>

      <div class="pt-3 border-t border-slate-100 flex items-center justify-end gap-2">
        <button type="button" id="cancelEditBtn" class="px-4 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-100 rounded-lg">Batal</button>
        <button type="submit" class="shadcn-button text-xs h-9 px-4">Simpan Perubahan</button>
      </div>
    </form>
  </div>
</div>

<script>
  let allRelawanData: any[] = [];

  const fetchRelawan = async () => {
    const tableBody = document.getElementById('relawanTableBody');
    const totalCount = document.getElementById('totalRelawanCount');

    try {
      const res = await fetch('/api/relawan');
      const json = await res.json();

      if (json.success && Array.isArray(json.data)) {
        allRelawanData = json.data;
        if (totalCount) totalCount.textContent = String(allRelawanData.length);
        renderTable();
      } else {
        if (tableBody) {
          tableBody.innerHTML = `<tr><td colspan="5" class="px-4 py-8 text-center text-rose-500">Gagal memuat data relawan.</td></tr>`;
        }
      }
    } catch (e) {
      if (tableBody) {
        tableBody.innerHTML = `<tr><td colspan="5" class="px-4 py-8 text-center text-rose-500">Kesalahan jaringan.</td></tr>`;
      }
    }
  };

  const renderTable = () => {
    const tableBody = document.getElementById('relawanTableBody');
    const searchInput = (document.getElementById('searchRelawan') as HTMLInputElement)?.value.toLowerCase().trim();
    const filterJabatan = (document.getElementById('filterJabatan') as HTMLSelectElement)?.value;

    if (!tableBody) return;

    let filtered = allRelawanData.filter(r => {
      const matchesSearch =
        !searchInput ||
        r.namaLengkap?.toLowerCase().includes(searchInput) ||
        r.nik?.includes(searchInput) ||
        r.email?.toLowerCase().includes(searchInput);

      const matchesJabatan = !filterJabatan || r.jabatan === filterJabatan;
      return matchesSearch && matchesJabatan;
    });

    if (filtered.length === 0) {
      tableBody.innerHTML = `
        <tr>
          <td colspan="5" class="px-4 py-12 text-center text-slate-400 font-medium">
            Tidak ada data relawan yang sesuai pencarian.
          </td>
        </tr>
      `;
      return;
    }

    tableBody.innerHTML = filtered.map(r => `
      <tr class="hover:bg-slate-50/80 transition-colors">
        <td class="px-4 py-3.5">
          <div class="font-bold text-slate-900">${escapeHtml(r.namaLengkap)}</div>
          <div class="font-mono text-xs text-slate-400">${escapeHtml(r.nik)}</div>
        </td>
        <td class="px-4 py-3.5">
          <div class="text-slate-800 text-xs">${escapeHtml(r.email)}</div>
          <div class="font-mono text-xs text-slate-500">${escapeHtml(r.nomorHp)}</div>
        </td>
        <td class="px-4 py-3.5">
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-800 border border-slate-200">
            ${escapeHtml(r.jabatan)}
          </span>
        </td>
        <td class="px-4 py-3.5 text-xs font-medium">
          <span class="inline-flex items-center gap-1 text-slate-700">
            ${r.jenisKelamin === 'Laki-laki'
              ? '<svg class="w-3.5 h-3.5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg> Laki-laki'
              : '<svg class="w-3.5 h-3.5 text-pink-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg> Perempuan'}
          </span>
        </td>
        <td class="px-4 py-3.5 text-right space-x-1">
          <button
            onclick="openEditModal(${r.id})"
            class="p-1.5 rounded-md text-slate-500 hover:text-indigo-600 hover:bg-indigo-50 transition-colors"
            title="Edit Data"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
            </svg>
          </button>
          <button
            onclick="deleteRelawanItem(${r.id})"
            class="p-1.5 rounded-md text-slate-400 hover:text-rose-600 hover:bg-rose-50 transition-colors"
            title="Hapus Relawan"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
            </svg>
          </button>
        </td>
      </tr>
    `).join('');
  };

  function escapeHtml(str: string) {
    if (!str) return '';
    return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  // Open Edit Modal
  (window as any).openEditModal = (id: number) => {
    const item = allRelawanData.find(r => r.id === id);
    if (!item) return;

    (document.getElementById('editId') as HTMLInputElement).value = String(item.id);
    (document.getElementById('editNama') as HTMLInputElement).value = item.namaLengkap || '';
    (document.getElementById('editNik') as HTMLInputElement).value = item.nik || '';
    (document.getElementById('editEmail') as HTMLInputElement).value = item.email || '';
    (document.getElementById('editJabatan') as HTMLSelectElement).value = item.jabatan || 'Persiapan';
    (document.getElementById('editHp') as HTMLInputElement).value = item.nomorHp || '';

    document.getElementById('editModal')?.classList.remove('hidden');
  };

  const closeEditModal = () => {
    document.getElementById('editModal')?.classList.add('hidden');
  };

  document.getElementById('closeEditModalBtn')?.addEventListener('click', closeEditModal);
  document.getElementById('cancelEditBtn')?.addEventListener('click', closeEditModal);

  // Edit Form Submission
  document.getElementById('editRelawanForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const formData = new FormData(form);

    const payload = {
      id: formData.get('id'),
      namaLengkap: formData.get('namaLengkap'),
      nik: formData.get('nik'),
      email: formData.get('email'),
      jabatan: formData.get('jabatan'),
      nomorHp: formData.get('nomorHp'),
    };

    try {
      const res = await fetch('/api/relawan', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      const json = await res.json();
      if (json.success) {
        closeEditModal();
        fetchRelawan();
      } else {
        alert('Gagal memperbarui: ' + json.message);
      }
    } catch (err: any) {
      alert('Error: ' + err.message);
    }
  });

  // Delete Item
  (window as any).deleteRelawanItem = async (id: number) => {
    if (!confirm('Apakah Anda yakin ingin menghapus data relawan ini?')) return;

    try {
      const res = await fetch(`/api/relawan?id=${id}`, { method: 'DELETE' });
      const json = await res.json();
      if (json.success) {
        allRelawanData = allRelawanData.filter(r => r.id !== id);
        const totalCount = document.getElementById('totalRelawanCount');
        if (totalCount) totalCount.textContent = String(allRelawanData.length);
        renderTable();
      } else {
        alert('Gagal menghapus: ' + json.message);
      }
    } catch (e: any) {
      alert('Error: ' + e.message);
    }
  };

  // EXPORT EXCEL (.xlsx / .csv format compatible)
  document.getElementById('exportExcelBtn')?.addEventListener('click', () => {
    if (allRelawanData.length === 0) {
      alert('Tidak ada data relawan untuk diekspor.');
      return;
    }

    const headers = ['ID', 'Nama Lengkap', 'NIK', 'Email', 'Divisi', 'Jenis Kelamin', 'Nomor HP'];
    const rows = allRelawanData.map(r => [
      r.id,
      `"${(r.namaLengkap || '').replace(/"/g, '""')}"`,
      `"${(r.nik || '')}"`,
      `"${(r.email || '')}"`,
      `"${(r.jabatan || '')}"`,
      `"${(r.jenisKelamin || '')}"`,
      `"${(r.nomorHp || '')}"`,
    ]);

    const csvContent = '\uFEFF' + [headers.join(','), ...rows.map(e => e.join(','))].join('\n');
    const blob = new Blob([csvContent], { type: 'application/vnd.ms-excel;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.setAttribute('href', url);
    link.setAttribute('download', `Relawan_Dapur_SPPG_Pahlawan_${new Date().toISOString().slice(0,10)}.csv`);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  });

  // EXPORT JSON
  document.getElementById('exportJsonBtn')?.addEventListener('click', () => {
    if (allRelawanData.length === 0) {
      alert('Tidak ada data relawan untuk diekspor.');
      return;
    }

    const jsonStr = JSON.stringify(allRelawanData, null, 2);
    const blob = new Blob([jsonStr], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.setAttribute('href', url);
    link.setAttribute('download', `Relawan_Dapur_SPPG_Pahlawan_${new Date().toISOString().slice(0,10)}.json`);
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  });

  document.getElementById('searchRelawan')?.addEventListener('input', renderTable);
  document.getElementById('filterJabatan')?.addEventListener('change', renderTable);

  fetchRelawan();
</script>
