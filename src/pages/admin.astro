---
// admin.astro – Protected admin dashboard with login page
import Layout from '../layouts/Layout.astro';
import DaftarRelawan from '../components/DaftarRelawan.astro';

export const prerender = false;

const isAuthenticated = Astro.cookies.get('admin_session')?.value === 'authenticated';
---

<Layout title="Admin | Dapur SPPG Pahlawan">
  {isAuthenticated ? (
    <div class="min-h-screen flex flex-col bg-slate-50">
      <!-- Minimal admin top bar -->
      <div class="bg-white border-b border-slate-200/80 sticky top-0 z-40">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between">
          <div class="flex items-center gap-2.5">
            <img src="/bgn.png" alt="Logo" class="h-7 w-auto object-contain" />
            <span class="text-xs font-semibold text-slate-500">Admin Dashboard</span>
          </div>
          <div class="flex items-center gap-3">
            <a href="/" class="text-xs text-slate-500 hover:text-slate-800 transition-colors">← Form Pendaftaran</a>
            <button
              id="logoutBtn"
              class="text-xs font-semibold text-rose-600 hover:text-rose-700 bg-rose-50 hover:bg-rose-100 px-3 py-1.5 rounded-lg border border-rose-200/60 transition-all cursor-pointer"
            >
              Keluar
            </button>
          </div>
        </div>
      </div>

      <main class="flex-1 max-w-6xl w-full mx-auto px-4 sm:px-6 py-8">
        <DaftarRelawan />
      </main>
    </div>
  ) : (
    <div class="min-h-screen flex flex-col items-center justify-center px-4 py-16 bg-slate-50">
      <div class="w-full max-w-sm space-y-6">
        <!-- Logo -->
        <div class="text-center space-y-3">
          <img src="/bgn.png" alt="Logo Dapur SPPG Pahlawan" class="h-14 w-auto object-contain mx-auto" />
          <div>
            <h2 class="text-xl font-bold text-slate-900">Login Admin</h2>
            <p class="text-xs text-slate-500 mt-0.5">Masukkan password untuk mengakses data relawan.</p>
          </div>
        </div>

        <div id="loginAlert" class="hidden p-3 rounded-xl text-xs font-medium border bg-rose-50 text-rose-700 border-rose-200 text-center"></div>

        <form id="loginForm" class="bg-white rounded-2xl border border-slate-200/80 shadow-xs divide-y divide-slate-100">
          <div class="p-5 space-y-4">
            <div class="space-y-1.5">
              <label for="adminPassword" class="block text-xs font-semibold text-slate-500 uppercase tracking-wider">
                Password
              </label>
              <input
                type="password"
                id="adminPassword"
                name="password"
                required
                placeholder="••••••••••••"
                class="shadcn-input"
              />
            </div>
          </div>
          <div class="px-5 py-4 bg-slate-50/50 rounded-b-2xl flex items-center justify-between">
            <a href="/" class="text-xs text-slate-400 hover:text-slate-700 font-medium">← Kembali</a>
            <button type="submit" class="shadcn-button text-xs h-9 px-5">Masuk</button>
          </div>
        </form>
      </div>
    </div>
  )}

  <script>
    // Login
    document.getElementById('loginForm')?.addEventListener('submit', async e => {
      e.preventDefault();
      const pw    = (document.getElementById('adminPassword') as HTMLInputElement).value;
      const alert = document.getElementById('loginAlert')!;
      try {
        const res  = await fetch('/api/login', {
          method : 'POST',
          headers: { 'Content-Type': 'application/json' },
          body   : JSON.stringify({ password: pw }),
        });
        const json = await res.json();
        if (res.ok && json.success) { window.location.reload(); }
        else {
          alert.textContent = json.message || 'Password salah';
          alert.classList.remove('hidden');
        }
      } catch (err: any) {
        alert.textContent = 'Kesalahan: ' + err.message;
        alert.classList.remove('hidden');
      }
    });

    // Logout
    document.getElementById('logoutBtn')?.addEventListener('click', async () => {
      await fetch('/api/login', { method: 'DELETE' });
      window.location.href = '/';
    });
  </script>
</Layout>
